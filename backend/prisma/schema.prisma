// МОТОР — Prisma Schema
// Соответствует документации: Раздел 03 — База данных

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════
// ПОЛЬЗОВАТЕЛИ И РОЛИ
// ══════════════════════════════════════

enum UserRole {
  CLIENT
  MASTER
  RECEPTIONIST
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  phoneMasked  String
  name         String
  email        String?
  passwordHash String   @default("")
  role         UserRole @default(CLIENT)
  pushToken    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // OTP авторизация
  otpCode      String?
  otpExpiresAt DateTime?
  otpAttempts  Int      @default(0)

  vehicles     Vehicle[]
  orders       Order[]   @relation("ClientOrders")
  staffOrders  Order[]   @relation("StaffOrders")
  slots        CalendarSlot[]

  @@index([phone])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ══════════════════════════════════════
// АВТОМОБИЛИ
// ══════════════════════════════════════

model Vehicle {
  id        String  @id @default(uuid())
  clientId  String
  client    User    @relation(fields: [clientId], references: [id])
  brand     String
  model     String
  year      Int
  mileage   Int?
  vinHash   String?   // VIN зашифрован
  plateNum  String?
  createdAt DateTime @default(now())

  orders    Order[]

  @@index([clientId])
  @@map("vehicles")
}

// ══════════════════════════════════════
// СПЕЦИАЛИСТЫ (ПОСТЫ)
// ══════════════════════════════════════

enum SpecialistType {
  MECHANIC       // Автослесарь
  ELECTRICIAN    // Автоэлектрик
  DIAGNOSTICS    // Диагност
}

model Post {
  id    String         @id @default(uuid())
  name  String         // "Пост #1 — Слесарный"
  type  SpecialistType
  isActive Boolean     @default(true)

  slots CalendarSlot[]

  @@map("posts")
}

// ══════════════════════════════════════
// КАЛЕНДАРЬ
// ══════════════════════════════════════

model CalendarSlot {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  masterId  String?
  master    User?    @relation(fields: [masterId], references: [id])
  startAt   DateTime
  endAt     DateTime
  isBooked  Boolean  @default(false)
  order     Order?

  @@index([postId])
  @@index([startAt])
  @@map("calendar_slots")
}

// ══════════════════════════════════════
// ЗАКАЗ-НАРЯДЫ (центральная таблица)
// ══════════════════════════════════════

enum OrderStatus {
  NEW           // Новый
  ASSESSED      // Оценён
  CONFIRMED     // Подтверждён клиентом
  IN_PROGRESS   // В работе
  READY         // Готов
  CLOSED        // Закрыт / Оплачен
  CANCELLED     // Отменён
}

enum SpecialistTypeOrder {
  MECHANIC
  ELECTRICIAN
  DIAGNOSTICS
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique // ЗН-2025-XXXX
  clientId        String
  client          User        @relation("ClientOrders", fields: [clientId], references: [id])
  vehicleId       String
  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id])
  staffId         String?
  staff           User?       @relation("StaffOrders", fields: [staffId], references: [id])
  slotId          String?     @unique
  slot            CalendarSlot? @relation(fields: [slotId], references: [id])
  specialistType  SpecialistTypeOrder
  complaintRaw    String       // Текст жалобы клиента
  complaintParsed Json?        // AI-структурированный JSON
  aiDiagResult    Json?        // Гипотезы и вероятности
  status          OrderStatus  @default(NEW)
  totalRetail     Decimal?     @db.Decimal(12, 2) // Розничная — клиент видит
  totalCost       Decimal?     @db.Decimal(12, 2) // Закупочная — конфиденциально
  paymentId       String?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           OrderItem[]
  messages        ChatMessage[]

  @@index([clientId])
  @@index([staffId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

// ══════════════════════════════════════
// ПОЗИЦИИ ЗАКАЗА
// ══════════════════════════════════════

enum OrderItemType {
  WORK
  PART
}

model OrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  type        OrderItemType
  name        String
  article     String?
  qty         Int           @default(1)
  costPrice   Decimal       @db.Decimal(12, 2) // Закупочная — конфиденциально
  retailPrice Decimal       @db.Decimal(12, 2) // Розничная
  markup      Int           // Процент наценки

  @@index([orderId])
  @@map("order_items")
}

// ══════════════════════════════════════
// ЗАПЧАСТИ
// ══════════════════════════════════════

enum PartCategory {
  OIL_FILTERS    // Масло и фильтры
  OEM            // Оригинал OEM
  AFTERMARKET    // Аналоги
  BRAKES         // Тормоза
  BODY           // Кузов
  CHEMICALS      // Химия, расходники
}

model Part {
  id          String      @id @default(uuid())
  article     String      @unique
  name        String
  category    PartCategory
  isOriginal  Boolean     @default(false)
  oemNumber   String?
  localStock  Int         @default(0)
  localCost   Decimal?    @db.Decimal(12, 2)
  weightKg    Decimal?    @db.Decimal(8, 3)
  cacheUpdAt  DateTime?
  createdAt   DateTime    @default(now())

  movements    StockMovement[]
  reservations StockReservation[]

  @@index([article])
  @@index([category])
  @@map("parts")
}

// ══════════════════════════════════════
// ПРАВИЛА ЦЕНООБРАЗОВАНИЯ
// ══════════════════════════════════════

model PriceRule {
  id          String      @id @default(uuid())
  category    PartCategory @unique
  markupPct   Int         // Процент наценки
  updatedAt   DateTime    @updatedAt
  updatedBy   String?     // userId администратора

  @@map("price_rules")
}

// ══════════════════════════════════════
// ЧАТ С AI-АГЕНТОМ
// ══════════════════════════════════════

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id        String      @id @default(uuid())
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id])
  userId    String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([userId])
  @@map("chat_messages")
}

// ══════════════════════════════════════
// АУДИТ-ЖУРНАЛ ЦЕН
// ══════════════════════════════════════

model PriceAuditLog {
  id          String   @id @default(uuid())
  orderId     String?
  itemName    String
  costPrice   Decimal  @db.Decimal(12, 2)
  retailPrice Decimal  @db.Decimal(12, 2)
  markupPct   Int
  performedBy String
  createdAt   DateTime @default(now())

  @@map("price_audit_log")
}

// ══════════════════════════════════════
// ИТЕРАЦИЯ 10 — СКЛАД И ЗАПЧАСТИ
// ══════════════════════════════════════

// Движение склада
enum StockMovementType {
  IN          // Приход (от поставщика)
  OUT         // Расход (в заказ)
  RESERVE     // Резерв под заказ
  UNRESERVE   // Снятие резерва
  ADJUSTMENT  // Инвентаризация
}

model StockMovement {
  id          String              @id @default(uuid())
  partId      String
  part        Part                @relation(fields: [partId], references: [id])
  type        StockMovementType
  qty         Int                 // > 0 приход, < 0 расход
  orderId     String?             // Если связан с заказом
  supplierId  String?
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  costPrice   Decimal?            @db.Decimal(12, 2)
  comment     String?
  performedBy String              // userId
  createdAt   DateTime            @default(now())

  @@index([partId])
  @@index([orderId])
  @@index([createdAt])
  @@map("stock_movements")
}

// Резервирование запчастей под заказы
model StockReservation {
  id        String   @id @default(uuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id])
  orderId   String
  qty       Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([partId])
  @@index([orderId])
  @@map("stock_reservations")
}

// Поставщики
enum SupplierType {
  EXIST       // Exist.ru API
  AUTODOC     // Autodoc.ru API
  MANUAL      // Ручной ввод
}

model Supplier {
  id         String       @id @default(uuid())
  name       String
  type       SupplierType @default(MANUAL)
  apiKey     String?
  apiUrl     String?
  phone      String?
  email      String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  movements  StockMovement[]
  orders     SupplierOrder[]

  @@map("suppliers")
}

// Заказы поставщикам
enum SupplierOrderStatus {
  DRAFT       // Черновик
  SENT        // Отправлен
  CONFIRMED   // Подтверждён
  DELIVERED   // Доставлен
  CANCELLED   // Отменён
}

model SupplierOrder {
  id          String              @id @default(uuid())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      SupplierOrderStatus @default(DRAFT)
  totalCost   Decimal?            @db.Decimal(12, 2)
  comment     String?
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items       SupplierOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id              String        @id @default(uuid())
  supplierOrderId String
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id])
  partId          String?
  article         String
  name            String
  qty             Int
  costPrice       Decimal       @db.Decimal(12, 2)
  isReceived      Boolean       @default(false)

  @@index([supplierOrderId])
  @@map("supplier_order_items")
}

// ══════════════════════════════════════
// ИТЕРАЦИЯ 11 — ФИНАНСЫ
// ══════════════════════════════════════

// Кассовая смена
enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id            String      @id @default(uuid())
  openedBy      String      // userId
  closedBy      String?
  status        ShiftStatus @default(OPEN)
  openCash      Decimal     @db.Decimal(12, 2) @default(0) // Остаток на начало
  closeCash     Decimal?    @db.Decimal(12, 2)             // Остаток на конец
  expectedCash  Decimal?    @db.Decimal(12, 2)             // По системе
  diffCash      Decimal?    @db.Decimal(12, 2)             // Расхождение
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  comment       String?

  transactions  CashTransaction[]

  @@index([status])
  @@index([openedAt])
  @@map("cash_shifts")
}

// Тип транзакции
enum TransactionType {
  INCOME_CASH      // Приход наличными
  INCOME_CARD      // Приход безналом / СБП
  EXPENSE          // Расход
  WITHDRAWAL       // Изъятие из кассы
  DEPOSIT          // Внесение в кассу
}

// Категория расхода
enum ExpenseCategory {
  SALARY           // Зарплата
  RENT             // Аренда
  PARTS_PURCHASE   // Закупка запчастей
  UTILITIES        // Коммунальные
  MARKETING        // Реклама
  EQUIPMENT        // Оборудование
  OTHER            // Прочее
}

model CashTransaction {
  id          String           @id @default(uuid())
  shiftId     String
  shift       CashShift        @relation(fields: [shiftId], references: [id])
  type        TransactionType
  category    ExpenseCategory?
  amount      Decimal          @db.Decimal(12, 2)
  orderId     String?          // Если привязан к заказу
  description String?
  performedBy String
  createdAt   DateTime         @default(now())

  @@index([shiftId])
  @@index([type])
  @@index([createdAt])
  @@map("cash_transactions")
}

// Плановые расходы (бюджет)
model ExpenseBudget {
  id        String          @id @default(uuid())
  category  ExpenseCategory @unique
  monthlyAmount Decimal     @db.Decimal(12, 2)
  updatedAt DateTime        @updatedAt
  updatedBy String?

  @@map("expense_budgets")
}

// ══════════════════════════════════════
// ИТЕРАЦИЯ 12 — ОНЛАЙН-ЗАПИСЬ
// ══════════════════════════════════════

enum BookingStatus {
  PENDING     // Ожидает подтверждения
  CONFIRMED   // Подтверждена
  COMPLETED   // Завершена (конвертирована в заказ)
  CANCELLED   // Отменена
  NO_SHOW     // Не явился
}

model Booking {
  id               String        @id @default(uuid())
  clientName       String
  clientPhone      String
  userId           String?       // Если клиент зарегистрирован
  serviceType      String
  description      String?
  vehicleMake      String?
  vehicleModel     String?
  vehiclePlate     String?
  scheduledAt      DateTime
  durationMin      Int           @default(60)
  status           BookingStatus @default(PENDING)
  masterId         String?
  source           String        @default("WIDGET") // WIDGET | MOBILE | MANUAL
  convertedOrderId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([scheduledAt])
  @@index([status])
  @@index([clientPhone])
  @@map("bookings")
}

// ══════════════════════════════════════
// ИТЕРАЦИИ 13-15
// ══════════════════════════════════════

// Бонусная программа — транзакции баллов
enum LoyaltyTxType {
  EARN       // Начисление за визит
  REDEEM     // Списание при оплате
  REFERRAL   // Реферальный бонус
  PROMO      // Промо-начисление
  EXPIRE     // Сгорание баллов
}

model LoyaltyTransaction {
  id          String        @id @default(uuid())
  userId      String
  type        LoyaltyTxType
  points      Int           // > 0 начисление, < 0 списание
  orderId     String?
  description String?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([orderId])
  @@map("loyalty_transactions")
}

// Реферальная программа
model Referral {
  id          String   @id @default(uuid())
  referrerId  String   // кто привёл
  refereeId   String   // кого привёл
  bonusPoints Int      @default(500)
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([refereeId])
  @@index([referrerId])
  @@map("referrals")
}

// Напоминания о ТО
model ToReminder {
  id          String   @id @default(uuid())
  vehicleId   String
  userId      String
  type        String   // oil_change | tire_rotation | inspection | etc
  dueDate     DateTime
  dueMileage  Int?
  isSent      Boolean  @default(false)
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([vehicleId])
  @@index([dueDate])
  @@index([isSent])
  @@map("to_reminders")
}

// ══════════════════════════════════════
// ИТЕРАЦИЯ 16 — ИНТЕГРАЦИИ
// ══════════════════════════════════════

// Выбранная система учёта
enum AccountingSystem {
  NONE          // Не подключено
  ONS_1C        // 1С:Предприятие (через REST HTTP-сервис)
  OPTIM_GARAGE  // Оптим Гараж (API)
}

// Настройки интеграции с системой учёта
model AccountingSettings {
  id          String           @id @default(uuid())
  system      AccountingSystem @default(NONE)
  // 1С
  oneC_url    String?          // http://server/ib/hs/motor/
  oneC_user   String?
  oneC_pass   String?          // зашифрован
  // Оптим Гараж
  optimUrl    String?
  optimApiKey String?
  // Общее
  autoSync    Boolean          @default(false)
  lastSyncAt  DateTime?
  syncErrors  String?
  updatedAt   DateTime         @updatedAt
  @@map("accounting_settings")
}

// Журнал синхронизации
enum SyncStatus {
  OK
  ERROR
  PARTIAL
}

model SyncLog {
  id         String     @id @default(uuid())
  system     AccountingSystem
  entityType String     // order | client | vehicle | payment
  entityId   String
  status     SyncStatus
  message    String?
  payload    String?    // JSON что отправили
  response   String?    // JSON что получили
  createdAt  DateTime   @default(now())

  @@index([entityId])
  @@index([createdAt])
  @@map("sync_logs")
}

// ══════════════════════════════════════
// ИТЕРАЦИЯ 18 — МУЛЬТИТЕНАНТНОСТЬ SaaS
// ══════════════════════════════════════

// Тариф
enum PlanType {
  STARTER    // 990 ₽/мес — 1 мастер
  PRO        // 2990 ₽/мес — до 5 мастеров
  BUSINESS   // 4990 ₽/мес — без лимитов
  TRIAL      // Бесплатный 14 дней
}

enum TenantStatus {
  ACTIVE
  SUSPENDED   // неоплата
  TRIAL
  CANCELLED
}

// Тенант — один автосервис
model Tenant {
  id           String       @id @default(uuid())
  slug         String       @unique  // motor-spb, avtomaster-msk
  name         String                // "Автосервис Победа"
  domain       String?      @unique  // победа-авто.рф (кастомный домен)
  plan         PlanType     @default(TRIAL)
  status       TenantStatus @default(TRIAL)
  trialEndsAt  DateTime?
  paidUntil    DateTime?
  // Брендинг
  logoUrl      String?
  primaryColor String?      @default("#ff6200")
  // Контакт владельца
  ownerEmail   String       @unique
  ownerPhone   String?
  // Настройки
  timezone     String       @default("Europe/Moscow")
  currency     String       @default("RUB")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users        TenantUser[]
  subscription Subscription?

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

// Привязка пользователя к тенанту
model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  role      String   @default("STAFF")
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_users")
}

// Подписка / биллинг
enum SubStatus {
  ACTIVE
  PAST_DUE   // просрочена
  CANCELLED
}

model Subscription {
  id              String    @id @default(uuid())
  tenantId        String    @unique
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  plan            PlanType
  status          SubStatus @default(ACTIVE)
  priceRub        Int
  // ЮKassa
  yukassaSubId    String?   @unique
  currentPeriodEnd DateTime?
  cancelAtEnd     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payments        Payment[]
  @@map("subscriptions")
}

// История платежей
model Payment {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amountRub      Int
  status         String       // succeeded | pending | cancelled
  yukassaId      String?      @unique
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
  @@map("payments")
}

// ══════════════════════════════════════
// ИТЕРАЦИЯ 21 — ЭДО, ФНС, ОНЛАЙН-КАССА
// ══════════════════════════════════════

// Документы ЭДО
enum EdoDocType {
  ACT            // Акт выполненных работ
  INVOICE        // Счёт на оплату
  UPD            // УПД (счёт-фактура + акт)
  INVOICE_RETURN // Корректировочный акт
}

enum EdoDocStatus {
  DRAFT          // Черновик
  SENT           // Отправлен контрагенту
  SIGNED         // Подписан обеими сторонами
  REJECTED       // Отклонён
  CANCELLED      // Аннулирован
}

enum EdoProvider {
  DIADOC         // Контур.Диадок
  SBIS           // СБИС
  KONTUR         // Контур.ЭДО
  MANUAL         // Ручной обмен (PDF)
}

model EdoDocument {
  id           String        @id @default(uuid())
  orderId      String?
  clientId     String?
  type         EdoDocType
  status       EdoDocStatus  @default(DRAFT)
  provider     EdoProvider   @default(MANUAL)
  docNumber    String
  docDate      DateTime      @default(now())
  totalAmount  Decimal       @db.Decimal(12, 2)
  vatAmount    Decimal?      @db.Decimal(12, 2)
  // Внешние ID в системе ЭДО
  externalId   String?
  externalUrl  String?
  // PDF
  pdfUrl       String?
  // Реквизиты контрагента
  counterpartyName  String?
  counterpartyInn   String?
  counterpartyKpp   String?
  createdBy    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orderId])
  @@index([clientId])
  @@index([status])
  @@index([docDate])
  @@map("edo_documents")
}

// Настройки ЭДО
model EdoSettings {
  id           String      @id @default(uuid())
  provider     EdoProvider @default(MANUAL)
  // Диадок
  diadocToken  String?
  diadocBoxId  String?
  // СБИС
  sbisLogin    String?
  sbisPassword String?
  // Реквизиты своей организации
  orgName      String?
  orgInn       String?
  orgKpp       String?
  orgOgrn      String?
  orgAddress   String?
  orgDirector  String?
  bankName     String?
  bankBik      String?
  bankAccount  String?
  bankCorr     String?
  // Налоговый режим
  taxSystem    String      @default("USN_INCOME") // USN_INCOME | USN_INCOME_MINUS | PATENT | OSNO
  vatRate      Int         @default(0)  // 0 | 20
  updatedAt    DateTime    @updatedAt
  @@map("edo_settings")
}

// Книга доходов и расходов (КУДиР для УСН)
model KudirEntry {
  id          String   @id @default(uuid())
  entryDate   DateTime
  docNumber   String
  docDate     DateTime
  operation   String   // Описание операции
  income      Decimal? @db.Decimal(12, 2)
  expense     Decimal? @db.Decimal(12, 2)
  orderId     String?
  createdAt   DateTime @default(now())

  @@index([entryDate])
  @@map("kudir_entries")
}

// Фискальные чеки (онлайн-касса 54-ФЗ)
enum ReceiptStatus {
  PENDING    // Ожидает фискализации
  DONE       // Фискализирован
  ERROR      // Ошибка
}

model FiscalReceipt {
  id           String        @id @default(uuid())
  orderId      String
  paymentId    String?
  status       ReceiptStatus @default(PENDING)
  // Атол
  atolUuid     String?       @unique
  fiscalNumber String?       // Фискальный признак
  fdNumber     Int?          // Номер ФД
  fnNumber     String?       // Номер ФН
  // Сумма
  totalAmount  Decimal       @db.Decimal(12, 2)
  cashAmount   Decimal?      @db.Decimal(12, 2)
  cardAmount   Decimal?      @db.Decimal(12, 2)
  // QR-код чека
  receiptQr    String?
  receiptUrl   String?
  errorMessage String?
  createdAt    DateTime      @default(now())

  @@index([orderId])
  @@index([status])
  @@map("fiscal_receipts")
}

// МЧД и автоматическая отчётность
enum ReportType {
  USN_DECLARATION
  KUDIR
  SFR_EFS1
  ROSSTAT_1MF
  NDC
}

enum ReportStatus {
  QUEUED
  SENT
  ACCEPTED
  REJECTED
  ERROR
}

model AutoReport {
  id          String       @id @default(uuid())
  type        ReportType
  status      ReportStatus @default(QUEUED)
  year        Int
  quarter     Int?
  operator    String       @default("manual")
  trackingId  String?
  xmlContent  String?
  message     String?
  sentAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([status])
  @@index([year])
  @@map("auto_reports")
}

model MchDRecord {
  id               String   @id @default(uuid())
  mchDId           String   @unique
  principalInn     String
  representativeName String
  authorities      String   // JSON массив
  validFrom        DateTime
  validTo          DateTime
  status           String   @default("active")
  registeredVia    String   @default("manual")
  fnsId            String?
  xmlContent       String?
  createdAt        DateTime @default(now())

  @@index([principalInn])
  @@map("mchd_records")
}
