// МОТОР — Prisma Schema
// Соответствует документации: Раздел 03 — База данных

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════
// ПОЛЬЗОВАТЕЛИ И РОЛИ
// ══════════════════════════════════════

enum UserRole {
  CLIENT
  MASTER
  RECEPTIONIST
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  phoneMasked  String
  name         String
  email        String?
  passwordHash String   @default("")
  role         UserRole @default(CLIENT)
  pushToken    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // OTP авторизация
  otpCode      String?
  otpExpiresAt DateTime?
  otpAttempts  Int      @default(0)

  vehicles     Vehicle[]
  orders       Order[]   @relation("ClientOrders")
  staffOrders  Order[]   @relation("StaffOrders")
  slots        CalendarSlot[]

  @@index([phone])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ══════════════════════════════════════
// АВТОМОБИЛИ
// ══════════════════════════════════════

model Vehicle {
  id        String  @id @default(uuid())
  clientId  String
  client    User    @relation(fields: [clientId], references: [id])
  brand     String
  model     String
  year      Int
  mileage   Int?
  vinHash   String?   // VIN зашифрован
  plateNum  String?
  createdAt DateTime @default(now())

  orders    Order[]

  @@index([clientId])
  @@map("vehicles")
}

// ══════════════════════════════════════
// СПЕЦИАЛИСТЫ (ПОСТЫ)
// ══════════════════════════════════════

enum SpecialistType {
  MECHANIC       // Автослесарь
  ELECTRICIAN    // Автоэлектрик
  DIAGNOSTICS    // Диагност
}

model Post {
  id    String         @id @default(uuid())
  name  String         // "Пост #1 — Слесарный"
  type  SpecialistType
  isActive Boolean     @default(true)

  slots CalendarSlot[]

  @@map("posts")
}

// ══════════════════════════════════════
// КАЛЕНДАРЬ
// ══════════════════════════════════════

model CalendarSlot {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  masterId  String?
  master    User?    @relation(fields: [masterId], references: [id])
  startAt   DateTime
  endAt     DateTime
  isBooked  Boolean  @default(false)
  order     Order?

  @@index([postId])
  @@index([startAt])
  @@map("calendar_slots")
}

// ══════════════════════════════════════
// ЗАКАЗ-НАРЯДЫ (центральная таблица)
// ══════════════════════════════════════

enum OrderStatus {
  NEW           // Новый
  ASSESSED      // Оценён
  CONFIRMED     // Подтверждён клиентом
  IN_PROGRESS   // В работе
  READY         // Готов
  CLOSED        // Закрыт / Оплачен
  CANCELLED     // Отменён
}

enum SpecialistTypeOrder {
  MECHANIC
  ELECTRICIAN
  DIAGNOSTICS
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique // ЗН-2025-XXXX
  clientId        String
  client          User        @relation("ClientOrders", fields: [clientId], references: [id])
  vehicleId       String
  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id])
  staffId         String?
  staff           User?       @relation("StaffOrders", fields: [staffId], references: [id])
  slotId          String?     @unique
  slot            CalendarSlot? @relation(fields: [slotId], references: [id])
  specialistType  SpecialistTypeOrder
  complaintRaw    String       // Текст жалобы клиента
  complaintParsed Json?        // AI-структурированный JSON
  aiDiagResult    Json?        // Гипотезы и вероятности
  status          OrderStatus  @default(NEW)
  totalRetail     Decimal?     @db.Decimal(12, 2) // Розничная — клиент видит
  totalCost       Decimal?     @db.Decimal(12, 2) // Закупочная — конфиденциально
  paymentId       String?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           OrderItem[]
  messages        ChatMessage[]

  @@index([clientId])
  @@index([staffId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

// ══════════════════════════════════════
// ПОЗИЦИИ ЗАКАЗА
// ══════════════════════════════════════

enum OrderItemType {
  WORK
  PART
}

model OrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  type        OrderItemType
  name        String
  article     String?
  qty         Int           @default(1)
  costPrice   Decimal       @db.Decimal(12, 2) // Закупочная — конфиденциально
  retailPrice Decimal       @db.Decimal(12, 2) // Розничная
  markup      Int           // Процент наценки

  @@index([orderId])
  @@map("order_items")
}

// ══════════════════════════════════════
// ЗАПЧАСТИ
// ══════════════════════════════════════

enum PartCategory {
  OIL_FILTERS    // Масло и фильтры
  OEM            // Оригинал OEM
  AFTERMARKET    // Аналоги
  BRAKES         // Тормоза
  BODY           // Кузов
  CHEMICALS      // Химия, расходники
}

model Part {
  id          String      @id @default(uuid())
  article     String      @unique
  name        String
  category    PartCategory
  isOriginal  Boolean     @default(false)
  oemNumber   String?
  localStock  Int         @default(0)
  localCost   Decimal?    @db.Decimal(12, 2)
  weightKg    Decimal?    @db.Decimal(8, 3)
  cacheUpdAt  DateTime?
  createdAt   DateTime    @default(now())

  movements    StockMovement[]
  reservations StockReservation[]

  @@index([article])
  @@index([category])
  @@map("parts")
}

// ══════════════════════════════════════
// ПРАВИЛА ЦЕНООБРАЗОВАНИЯ
// ══════════════════════════════════════

model PriceRule {
  id          String      @id @default(uuid())
  category    PartCategory @unique
  markupPct   Int         // Процент наценки
  updatedAt   DateTime    @updatedAt
  updatedBy   String?     // userId администратора

  @@map("price_rules")
}

// ══════════════════════════════════════
// ЧАТ С AI-АГЕНТОМ
// ══════════════════════════════════════

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id        String      @id @default(uuid())
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id])
  userId    String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([userId])
  @@map("chat_messages")
}

// ══════════════════════════════════════
// АУДИТ-ЖУРНАЛ ЦЕН
// ══════════════════════════════════════

model PriceAuditLog {
  id          String   @id @default(uuid())
  orderId     String?
  itemName    String
  costPrice   Decimal  @db.Decimal(12, 2)
  retailPrice Decimal  @db.Decimal(12, 2)
  markupPct   Int
  performedBy String
  createdAt   DateTime @default(now())

  @@map("price_audit_log")
}

// ══════════════════════════════════════
// ИТЕРАЦИЯ 10 — СКЛАД И ЗАПЧАСТИ
// ══════════════════════════════════════

// Движение склада
enum StockMovementType {
  IN          // Приход (от поставщика)
  OUT         // Расход (в заказ)
  RESERVE     // Резерв под заказ
  UNRESERVE   // Снятие резерва
  ADJUSTMENT  // Инвентаризация
}

model StockMovement {
  id          String              @id @default(uuid())
  partId      String
  part        Part                @relation(fields: [partId], references: [id])
  type        StockMovementType
  qty         Int                 // > 0 приход, < 0 расход
  orderId     String?             // Если связан с заказом
  supplierId  String?
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  costPrice   Decimal?            @db.Decimal(12, 2)
  comment     String?
  performedBy String              // userId
  createdAt   DateTime            @default(now())

  @@index([partId])
  @@index([orderId])
  @@index([createdAt])
  @@map("stock_movements")
}

// Резервирование запчастей под заказы
model StockReservation {
  id        String   @id @default(uuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id])
  orderId   String
  qty       Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([partId])
  @@index([orderId])
  @@map("stock_reservations")
}

// Поставщики
enum SupplierType {
  EXIST       // Exist.ru API
  AUTODOC     // Autodoc.ru API
  MANUAL      // Ручной ввод
}

model Supplier {
  id         String       @id @default(uuid())
  name       String
  type       SupplierType @default(MANUAL)
  apiKey     String?
  apiUrl     String?
  phone      String?
  email      String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  movements  StockMovement[]
  orders     SupplierOrder[]

  @@map("suppliers")
}

// Заказы поставщикам
enum SupplierOrderStatus {
  DRAFT       // Черновик
  SENT        // Отправлен
  CONFIRMED   // Подтверждён
  DELIVERED   // Доставлен
  CANCELLED   // Отменён
}

model SupplierOrder {
  id          String              @id @default(uuid())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      SupplierOrderStatus @default(DRAFT)
  totalCost   Decimal?            @db.Decimal(12, 2)
  comment     String?
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items       SupplierOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id              String        @id @default(uuid())
  supplierOrderId String
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id])
  partId          String?
  article         String
  name            String
  qty             Int
  costPrice       Decimal       @db.Decimal(12, 2)
  isReceived      Boolean       @default(false)

  @@index([supplierOrderId])
  @@map("supplier_order_items")
}

// ══════════════════════════════════════
// ИТЕРАЦИЯ 11 — ФИНАНСЫ
// ══════════════════════════════════════

// Кассовая смена
enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id            String      @id @default(uuid())
  openedBy      String      // userId
  closedBy      String?
  status        ShiftStatus @default(OPEN)
  openCash      Decimal     @db.Decimal(12, 2) @default(0) // Остаток на начало
  closeCash     Decimal?    @db.Decimal(12, 2)             // Остаток на конец
  expectedCash  Decimal?    @db.Decimal(12, 2)             // По системе
  diffCash      Decimal?    @db.Decimal(12, 2)             // Расхождение
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  comment       String?

  transactions  CashTransaction[]

  @@index([status])
  @@index([openedAt])
  @@map("cash_shifts")
}

// Тип транзакции
enum TransactionType {
  INCOME_CASH      // Приход наличными
  INCOME_CARD      // Приход безналом / СБП
  EXPENSE          // Расход
  WITHDRAWAL       // Изъятие из кассы
  DEPOSIT          // Внесение в кассу
}

// Категория расхода
enum ExpenseCategory {
  SALARY           // Зарплата
  RENT             // Аренда
  PARTS_PURCHASE   // Закупка запчастей
  UTILITIES        // Коммунальные
  MARKETING        // Реклама
  EQUIPMENT        // Оборудование
  OTHER            // Прочее
}

model CashTransaction {
  id          String           @id @default(uuid())
  shiftId     String
  shift       CashShift        @relation(fields: [shiftId], references: [id])
  type        TransactionType
  category    ExpenseCategory?
  amount      Decimal          @db.Decimal(12, 2)
  orderId     String?          // Если привязан к заказу
  description String?
  performedBy String
  createdAt   DateTime         @default(now())

  @@index([shiftId])
  @@index([type])
  @@index([createdAt])
  @@map("cash_transactions")
}

// Плановые расходы (бюджет)
model ExpenseBudget {
  id        String          @id @default(uuid())
  category  ExpenseCategory @unique
  monthlyAmount Decimal     @db.Decimal(12, 2)
  updatedAt DateTime        @updatedAt
  updatedBy String?

  @@map("expense_budgets")
}

// ══════════════════════════════════════
// ИТЕРАЦИЯ 12 — ОНЛАЙН-ЗАПИСЬ
// ══════════════════════════════════════

enum BookingStatus {
  PENDING     // Ожидает подтверждения
  CONFIRMED   // Подтверждена
  COMPLETED   // Завершена (конвертирована в заказ)
  CANCELLED   // Отменена
  NO_SHOW     // Не явился
}

model Booking {
  id               String        @id @default(uuid())
  clientName       String
  clientPhone      String
  userId           String?       // Если клиент зарегистрирован
  serviceType      String
  description      String?
  vehicleMake      String?
  vehicleModel     String?
  vehiclePlate     String?
  scheduledAt      DateTime
  durationMin      Int           @default(60)
  status           BookingStatus @default(PENDING)
  masterId         String?
  source           String        @default("WIDGET") // WIDGET | MOBILE | MANUAL
  convertedOrderId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([scheduledAt])
  @@index([status])
  @@index([clientPhone])
  @@map("bookings")
}

// ══════════════════════════════════════
// ИТЕРАЦИИ 13-15
// ══════════════════════════════════════

// Бонусная программа — транзакции баллов
enum LoyaltyTxType {
  EARN       // Начисление за визит
  REDEEM     // Списание при оплате
  REFERRAL   // Реферальный бонус
  PROMO      // Промо-начисление
  EXPIRE     // Сгорание баллов
}

model LoyaltyTransaction {
  id          String        @id @default(uuid())
  userId      String
  type        LoyaltyTxType
  points      Int           // > 0 начисление, < 0 списание
  orderId     String?
  description String?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([orderId])
  @@map("loyalty_transactions")
}

// Реферальная программа
model Referral {
  id          String   @id @default(uuid())
  referrerId  String   // кто привёл
  refereeId   String   // кого привёл
  bonusPoints Int      @default(500)
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([refereeId])
  @@index([referrerId])
  @@map("referrals")
}

// Напоминания о ТО
model ToReminder {
  id          String   @id @default(uuid())
  vehicleId   String
  userId      String
  type        String   // oil_change | tire_rotation | inspection | etc
  dueDate     DateTime
  dueMileage  Int?
  isSent      Boolean  @default(false)
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([vehicleId])
  @@index([dueDate])
  @@index([isSent])
  @@map("to_reminders")
}
