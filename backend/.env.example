# ══════════════════════════════════════════════════════════
# МОТОР — конфигурация (все сервисы бесплатные)
# ══════════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173

# Database (бесплатно: PostgreSQL self-hosted / Supabase free tier)
DATABASE_URL="postgresql://motor:password@localhost:5432/motor_db"

# Redis (бесплатно: self-hosted / Upstash free tier)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET=замените_на_случайную_строку_минимум_32_символа
JWT_REFRESH_SECRET=замените_на_другую_случайную_строку_32_символа
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── AI-агенты (выберите один бесплатный провайдер) ────────
AI_PROVIDER=auto   # auto | groq | ollama | openrouter | anthropic

# Groq (РЕКОМЕНДУЕТСЯ — быстро, бесплатно 30 req/min)
# Регистрация: https://console.groq.com → API Keys → Free
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (локально, полностью бесплатно)
# Установка: https://ollama.ai → ollama pull llama3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenRouter (бесплатные модели, 200 req/day)
# Регистрация: https://openrouter.ai → бесплатный ключ
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Anthropic (платный fallback — только если нужно)
# ANTHROPIC_API_KEY=sk-ant-...

# ── OTP-уведомления (выберите канал) ─────────────────────
OTP_CHANNEL=console   # console | email | telegram

# Email через Gmail (бесплатно)
# Настройка: Google Account → Безопасность → Пароли приложений
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Telegram Bot (бесплатно)
# Создать бота: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# ── Push-уведомления (Web Push VAPID — бесплатно) ─────────
# Генерация ключей: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BK...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:admin@motor-app.ru

# ── Оплата (СБП — бесплатно для ИП/ООО) ─────────────────
# Комиссия 0% до 1 млн руб/мес
SBP_PHONE=+79001234567       # номер телефона, привязанный к СБП
SBP_BANK_ID=tinkoff          # tinkoff | sberbank | vtb | alfabank
SBP_MERCHANT_ID=             # опционально

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://motor-app.ru
