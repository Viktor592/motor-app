{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios":     { "simulator": true },
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleDebug" },
      "env": {
        "APP_ENV": "development",
        "API_URL": "http://localhost:3000/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios":     { "simulator": false },
      "env": {
        "APP_ENV": "preview",
        "API_URL": "https://staging.motor-app.ru/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "ios":     { "credentialsSource": "remote" },
      "env": {
        "APP_ENV": "production",
        "API_URL": "https://motor-app.ru/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "REPLACE_WITH_APPLE_ID",
        "ascAppId": "REPLACE_WITH_APP_STORE_APP_ID",
        "appleTeamId": "REPLACE_WITH_TEAM_ID"
      }
    }
  },
  "update": {
    "channel": "production"
  }
}
