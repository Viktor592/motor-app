# ══════════════════════════════════════════════════════
# МОТОР — Production Environment
# Скопируй в .env и заполни все значения
# ══════════════════════════════════════════════════════

# ── Домен ──────────────────────────────────────────────
DOMAIN=motor-app.ru
CERTBOT_EMAIL=admin@motor-app.ru

# ── Docker Hub ─────────────────────────────────────────
DOCKER_USER=viktor592

# ── База данных ────────────────────────────────────────
POSTGRES_DB=motor_db
POSTGRES_USER=motor
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ_32_СИМВОЛА

# ── Redis ──────────────────────────────────────────────
REDIS_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ

# ── JWT (минимум 32 символа каждый) ───────────────────
JWT_ACCESS_SECRET=ЗАМЕНИ_access_secret_минимум_32_символа
JWT_REFRESH_SECRET=ЗАМЕНИ_refresh_secret_минимум_32_символа

# ── AI ─────────────────────────────────────────────────
AI_PROVIDER=auto          # auto | groq | ollama
GROQ_API_KEY=gsk_...      # Бесплатно: https://console.groq.com
OPENROUTER_API_KEY=       # Для Vision (фото-диагностика): https://openrouter.ai

# ── Telegram Bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC...   # @BotFather
TELEGRAM_CHAT_ID=-100...           # ID чата для уведомлений о деплое

# ── Оплата СБП ─────────────────────────────────────────
SBP_PHONE=+79001234567

# ── Push-уведомления (Web Push VAPID) ─────────────────
# Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BK...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:admin@motor-app.ru

# ── Мониторинг ─────────────────────────────────────────
GRAFANA_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ

# ── S3-бэкапы (Selectel / Yandex Object Storage) ──────
S3_BUCKET=motor-backups
S3_ENDPOINT=https://s3.selcdn.ru   # или https://storage.yandexcloud.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Integrations ───────────────────────────────────────
APP_URL=https://motor-app.ru

# ── ЭДО и Отчётность ───────────────────────────────────────────
# Контур.Экстерн (для авто-отправки деклараций в ФНС/СФР)
KONTUR_API_KEY=         # API-ключ из lk.kontur.ru → Настройки → API

# Атол Онлайн (онлайн-касса 54-ФЗ)
ATOL_LOGIN=             # Логин из lk.atol.ru
ATOL_PASSWORD=          # Пароль
ATOL_GROUP=             # Код группы (groupCode)
ATOL_INN=               # ИНН вашей организации
ATOL_TAX_SYSTEM=usn_income  # usn_income | usn_income_minus | patent | osno
ATOL_ADDRESS=           # Адрес расчётов (для чека)
ATOL_COMPANY_EMAIL=     # Email организации (для чека)
